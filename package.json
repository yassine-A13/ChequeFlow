{
    "name": "chequeflow",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "dev:vite": "vite",
        "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
        "test:status": "node --experimental-strip-types --test src/services/cheque-status.service.test.mjs",
