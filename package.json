        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.7",
        "@types/web-push": "^3.6.4",
        "@vitejs/plugin-react": "^6.1.1",
        "eslint": "^10.11.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "oxlint": "^1.81.0",
        "prisma": "^7.10.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.70.1",
        "vercel": "^61.1.0",
        "vite": "^8.3.0"
