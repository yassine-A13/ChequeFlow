# Neon pooled connection string for application runtime (use the -pooler endpoint).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Direct Neon connection string for Prisma Migrate. Keep this server-side only.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

VITE_NEON_AUTH_URL=https://ep-flat-math-b53evoc7.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth

# Web Push VAPID credentials. Generate a key pair with:
# npx web-push generate-vapid-keys --json
# Keep the private key server-side; only the public key may be sent to browsers.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com

# Private Vercel Blob store. Vercel injects OIDC configuration for a connected store;
# set this server-only token for local development when OIDC is not available.
BLOB_READ_WRITE_TOKEN=

# Resend email service credentials (server only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRON_SECRET=
