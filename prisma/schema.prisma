generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChequeStatus {
  PENDING
  PROCESSING
  CASHED
  NOT_CASHED
  CANCELLED
  EXPIRED
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  WEB
}

enum NotificationType {
  DUE_48H
  DUE_TODAY
  OVERDUE
}

enum NotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
  CANCELLED
}

enum ExportFormat {
  XLSX
  PDF
  CSV
  JSON
}

enum ExportScope {
  ALL
  SELECTED
  SINGLE
  FILTERED
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  name          String?
  email         String?         @unique
  passwordHash  String?         @map("password_hash")
  emailVerified DateTime?       @map("email_verified") @db.Timestamptz(6)
  phone         String?         @unique
  image         String?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  cheques       Cheque[]
  notifications Notification[]
  exportHistory ExportHistory[]
  accounts      Account[]
  sessions      Session[]
  phoneOtps     PhoneOtp[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

model Cheque {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  beneficiary  String
  amount       Decimal         @db.Decimal(12, 2)
  chequeNumber String          @map("cheque_number")
  bank         String?
  issueDate    DateTime        @map("issue_date") @db.Date
  dueDate      DateTime        @map("due_date") @db.Date
  reminder48hSentAt DateTime? @map("reminder_48h_sent_at") @db.Timestamptz(6)
  status       ChequeStatus    @default(PENDING)
  note         String?
  imageUrl     String?         @map("image_url")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([id, userId], map: "cheques_id_user_id_key")
  @@index([userId], map: "cheques_user_id_idx")
  @@index([dueDate], map: "cheques_due_date_idx")
  @@index([issueDate], map: "cheques_issue_date_idx")
  @@index([status], map: "cheques_status_idx")
  @@index([beneficiary], map: "cheques_beneficiary_idx")
  @@index([chequeNumber], map: "cheques_cheque_number_idx")
  @@index([userId, dueDate], map: "cheques_user_id_due_date_idx")
  @@index([userId, issueDate], map: "cheques_user_id_issue_date_idx")
  @@index([userId, status, dueDate], map: "cheques_user_id_status_due_date_idx")
  @@index([userId, chequeNumber], map: "cheques_user_id_cheque_number_idx")
  @@map("cheques")
}

model Notification {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  chequeId     String             @map("cheque_id") @db.Uuid
  channel       NotificationChannel
  type          NotificationType
  scheduledAt   DateTime           @map("scheduled_at") @db.Timestamptz(6)
  sentAt        DateTime?          @map("sent_at") @db.Timestamptz(6)
  status        NotificationStatus @default(PENDING)
  errorMessage  String?            @map("error_message")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cheque        Cheque             @relation(fields: [chequeId, userId], references: [id, userId], onDelete: Cascade)

  @@index([userId], map: "notifications_user_id_idx")
  @@index([chequeId], map: "notifications_cheque_id_idx")
  @@index([scheduledAt], map: "notifications_scheduled_at_idx")
  @@index([status], map: "notifications_status_idx")
  @@index([userId, scheduledAt], map: "notifications_user_id_scheduled_at_idx")
  @@map("notifications")
}

model ExportHistory {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  format    ExportFormat
  scope     ExportScope
  fileUrl   String?      @map("file_url")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "export_history_user_id_idx")
  @@index([createdAt], map: "export_history_created_at_idx")
  @@index([userId, createdAt], map: "export_history_user_id_created_at_idx")
  @@map("export_history")
}

// Auth.js adapter tables prepare future OAuth/session support; no auth flow is implemented here.
model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique(map: "push_subscriptions_endpoint_key") @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "push_subscriptions_user_id_idx")
  @@map("push_subscriptions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(6)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique @map("token_hash")
  expires   DateTime @db.Timestamptz(6)
  @@index([email])
  @@map("password_reset_tokens")
}

model PhoneOtp {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String   @map("code_hash")
  expires   DateTime @db.Timestamptz(6)
  attempts  Int      @default(0)
  userId    String?  @map("user_id") @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([phone])
  @@map("phone_otps")
}

model AuthRateLimit {
  key         String   @id
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  attempts    Int      @default(1)
  @@index([windowStart])
  @@map("auth_rate_limits")
}
